NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Production (Netlify): https://carehive-bitvion.netlify.app


# Optional public social profile URLs. Leave empty until official pages exist.
# Only set real https URLs — empty values keep social placeholders inactive.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Optional Google Maps embed URL for the contact page.
# Example: https://www.google.com/maps/embed?pb=...
# Do not invent coordinates.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Admin lead dashboard. Required to access /admin and /admin/leads.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Lead storage mode. Default is local JSON file storage.
LEAD_STORE=file

# Optional webhook for CRM / Google Sheets / Make / Zapier.
LEADS_WEBHOOK_URL=

# Optional email notification via Resend when a lead is submitted.
# Requires a verified Resend sending domain in production.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_FROM=

# Optional future database connection. File storage is used until this is set.
DATABASE_URL=
